{
  "nodeModulesDir": "auto",
  "fmt": {
    "exclude": ["client/"]
  },
  "lint": {
    "exclude": ["client/"]
  },
  "test": {
    "exclude": ["client/"]
  },
  "imports": {
    "lib": "./lib/mod.ts",
    "platform-lib": "../platform/lib/mod.ts",
    "@clerk/backend": "npm:@clerk/backend@^1.25.2",
    "@hono/clerk-auth": "npm:@hono/clerk-auth@^2.0.0",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.71.0",
    "@gfx/canvas": "jsr:@gfx/canvas@0.5.6",
    "@std/assert": "jsr:@std/assert@1.0.0",
    "@std/encoding/base64": "jsr:@std/encoding@0.217.0/base64",
    "@std/fs/copy": "jsr:@std/fs@0.217.0/copy",
    "@std/fs/empty_dir": "jsr:@std/fs@0.217.0/empty_dir",
    "@std/fs/ensure_dir": "jsr:@std/fs@0.217.0/ensure_dir",
    "@std/fs/ensure_file": "jsr:@std/fs@0.217.0/ensure_file",
    "@std/fs/walk": "jsr:@std/fs@0.217.0/walk",
    "@std/path": "jsr:@std/path@0.217.0",
    "@std/path/glob_to_regexp": "jsr:@std/path@0.217.0/glob_to_regexp",
    "@std/yaml": "jsr:@std/yaml@1.0.5",
    "@timroberton/panther": "../platform/panther/mod.deno.ts",
    "@vscode/markdown-it-katex": "npm:@vscode/markdown-it-katex@^1.1.2",
    "codemirror": "npm:codemirror@^6.0.0",
    "@codemirror/lang-markdown": "npm:@codemirror/lang-markdown@^6.0.0",
    "@codemirror/merge": "npm:@codemirror/merge@^6.0.0",
    "@codemirror/state": "npm:@codemirror/state@^6.0.0",
    "@solidjs/router": "npm:@solidjs/router@^0.15.0",
    "docx": "npm:docx@^9.5.1",
    "hono": "npm:hono@4.11.3",
    "idb-keyval": "npm:idb-keyval@^6.2.1",
    "jspdf": "npm:jspdf@^3.0.1",
    "katex": "npm:katex@^0.16.0",
    "markdown-it": "npm:markdown-it@^14.1.0",
    "nanoid": "npm:nanoid@^5.0.0",
    "opentype.js": "npm:opentype.js@^1.3.4",
    "papaparse": "npm:papaparse@5.4.1",
    "postgres": "npm:postgres@^3.4.5",
    "pptxgenjs": "npm:pptxgenjs@^4.0.1",
    "solid-js": "npm:solid-js@^1.9.0",
    "solid-js/store": "npm:solid-js@^1.9.0/store",
    "solid-js/web": "npm:solid-js@^1.9.0/web",
    "sortablejs": "npm:sortablejs@^1.15.0",
    "xlsx": "npm:xlsx@0.18.5",
    "zod": "npm:zod@^4.0.0"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx",
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"]
  },
  "tasks": {
    "dev": "deno run --allow-all --env-file --unstable-broadcast-channel main.ts",
    "build:client": "cd client && npm run build",
    "typecheck": "deno check main.ts && echo '✓ Server typecheck passed' && sh -c 'cd client && npm run typecheck' && echo '✓ Client typecheck passed'",
    "check": "deno check main.ts",
    "start": "deno run --allow-all --env-file --unstable-broadcast-channel main.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  }
}
